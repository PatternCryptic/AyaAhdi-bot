# ID entre /d/ e /edit no endereço da planilha
SPREADSHEET_ID=

# Caminho do JSON baixado do seu próprio Service Account (arquivo fora do Git)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Nome da aba e colunas A:H
SHEETS_RANGE=Página1!A:H

# Opcional: JIDs dos grupos permitidos, separados por vírgula.
# Vazio = captura mensagens com a palavra em qualquer grupo.
ALLOWED_GROUP_JIDS=
